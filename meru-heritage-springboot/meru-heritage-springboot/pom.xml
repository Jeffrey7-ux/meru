<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot's "parent" POM gives us sensible default versions for
       every dependency below, so we don't have to pick them ourselves. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.meru</groupId>
  <artifactId>meru-heritage</artifactId>
  <version>1.0.0</version>
  <name>meru-heritage</name>
  <description>Meru Heritage website backend (Spring Boot)</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- Everything needed for REST controllers (@RestController, JSON
         serialization via Jackson) AND for serving the static frontend
         files from src/main/resources/static. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Testing support (optional, but standard on every Spring Boot project). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
